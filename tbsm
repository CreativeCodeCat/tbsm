# function to handle PIN login
function pinLogin {
    if [[ $enablePinLogin -eq 1 && -n "$userPin" ]]; then
        local attempts=3
        local maxAttempts=3
        
        while [[ $attempts -gt 0 ]]; do
            pageColor "$sysPageColor" "clear"
            echo -e "\n${boldText}${bannerTextColor}"
            center "████████╗██████╗ ███████╗███╗   ███╗"
            center "╚══██╔══╝██╔══██╗██╔════╝████╗ ████║"
            center "   ██║   ██████╔╝███████╗██╔████╔██║"
            center "   ██║   ██╔══██╗╚════██║██║╚██╔╝██║"
            center "   ██║   ██████╔╝███████║██║ ╚═╝ ██║"
            center "   ╚═╝   ╚═════╝ ╚══════╝╚═╝     ╚═╝"
            echo "${resetColor}"
            
            center "${importantTextColor}PIN LOGIN"
            newline
            center "${informationTextColor}Enter your PIN to continue"
            center "${informationTextColor}Attempts remaining: $attempts"
            newline
            
            # Disable echo for PIN input
            stty -echo
            read -p "$(centerText "${normalTextColor}PIN: ")" enteredPin
            stty echo
            newline
            newline
            
            if [[ "$enteredPin" == "$userPin" ]]; then
                return 0
            else
                center "${boldText}$(tput setaf 1)Incorrect PIN!${resetColor}"
                sleep 2
                ((attempts--))
            fi
        done
        
        # Too many failed attempts
        pageColor "$sysPageColor" "clear"
        center "${boldText}$(tput setaf 1)Too many failed attempts!${resetColor}"
        center "${informationTextColor}Access denied."
        sleep 3
        exec $SHELL
    fi
    return 0
}

