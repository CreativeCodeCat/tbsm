    # check PIN login if enabled
    pinLogin
    # show the menu entries for user
    menuEntries
    # pass the desktop name or selected options to startDesktop function
    #echo "selected ${options[$choice]}"
    center " you selected \"${options[$choice]}\" item"
    sleep 2s
    #clear and change background page
    tput reset && clear
    exit
fi

# main commands
if [[ "$restrictToVT1" -eq 1 ]]; then
    # Old behavior: only run on VT1 if no X server is running
    if [[ ! $DISPLAY && $XDG_VTNR -eq 1 ]]; then
        # reset the terminal
        tput reset
        setTermColors
        # print the script banner
        printBanner
        # check PIN login if enabled
        pinLogin
        # show the menu entries for user
        menuEntries
        # pass the desktop name or selected options to startDesktop function
        startDesktop ${options[$choice]}
    else
        echo "Error : Another Xserver is running or not on VT1!, Abort."
        exit
    fi
else
    # New behavior: run on any TTY regardless of X server
    # reset the terminal
    tput reset
    setTermColors
    # print the script banner
    printBanner
    # check PIN login if enabled
    pinLogin
    # show the menu entries for user
    menuEntries
    # pass the desktop name or selected options to startDesktop function
    startDesktop ${options[$choice]}
fi
