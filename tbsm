# function to start desktop environment
function startDesktop {
    if [[ $1 == "TTY" ]]; then
        tput clear
        exec $SHELL
    elif [[ $1 == "reboot" ]]; then
        tput clear
        echo "REBOOTING..."
        sleep 3
        reboot
    elif [[ $1 == "shutdown" ]]; then
        tput clear
        echo "SHUTTING DOWN..."
        sleep 3
        shutdown -h now
    fi
    
    local sessionType="x11"
    local desktopFile=""
    local execCommand=""
    
    # Determine if it's a Wayland or X11 session
    if [[ -f "/usr/share/wayland-sessions/$1.desktop" ]]; then
        sessionType="wayland"
        desktopFile="/usr/share/wayland-sessions/$1.desktop"
    elif [[ -f "/usr/share/xsessions/$1.desktop" ]]; then
        sessionType="x11"
        desktopFile="/usr/share/xsessions/$1.desktop"
    else
        echo "${boldText}$(tput setaf 1)Error: Desktop file for '$1' not found!${resetColor}"
        sleep 3
        exec $SHELL
    fi
    
    # start chosen desktop environment from Exec command in .desktop file!
    echo "${normalTextColor}starting $1 ($sessionType) ! please wait... ${resetColor}"
    execCommand=$(which $(grep "^Exec" "$desktopFile" | sed 's/Exec=//'))
    
    # Check if exec command was found
    if [[ -z "$execCommand" ]]; then
        echo "${boldText}$(tput setaf 1)Error: Could not find executable for '$1'!${resetColor}"
        sleep 3
        exec $SHELL
    fi
    
    # Warning if X server is already running (when not restricted to VT1)
    if [[ -n "$DISPLAY" ]] && [[ "$restrictToVT1" -eq 0 ]]; then
        echo "${informationTextColor}Note: An X server is already running on another TTY.${resetColor}"
        sleep 1
    fi
    
    # Start the session based on type
    if [[ "$sessionType" == "wayland" ]]; then
        # Start Wayland session
        DESKTOP_SESSION="$1" exec $execCommand
    else
        # Start X11 session
        if [[ "$runXinitrc" == 1 ]] && [[ -e "$HOME/.xsession" ]]; then
            DESKTOP_SESSION="$1" exec startx "$HOME/.xsession" "$execCommand"
        elif [[ "$runXinitrc" == 1 ]] && [[ -e "$HOME/.xinitrc" ]]; then
            DESKTOP_SESSION="$1" exec startx "$HOME/.xinitrc" "$execCommand"
        fi
        DESKTOP_SESSION="$1" exec startx "$execCommand"
    fi
}

# function to search in array elements
function containsElement {
    local e match="$1"
    shift
    for e; do [[ "$e" == "$match" ]] && return 0; done
    return 1
}

# function to create the menu list entries and configure them with config file
function menuEntries {
    # manual for user
    centerText "${normalTextColor} Select an entry using ${importantTextColor} up/down ${normalTextColor} or ${importantTextColor} left/right ${normalTextColor} keys and ${importantTextColor}enter${normalTextColor} to confirm: ${resetColor}"
    newline
    newline
    
    # get all installed graphical environments
    local x11_desktops=""
    local wayland_sessions=""
    
    if [[ -d /usr/share/xsessions ]]; then
        x11_desktops=$(ls /usr/share/xsessions/ 2>/dev/null | sed 's/.desktop//g')
    fi
    
    if [[ "$enableWayland" -eq 1 ]] && [[ -d /usr/share/wayland-sessions ]]; then
        wayland_sessions=$(ls /usr/share/wayland-sessions/ 2>/dev/null | sed 's/.desktop//g')
    fi
    
    # Combine sessions, removing duplicates
    local all_sessions=$(echo -e "${x11_desktops}\n${wayland_sessions}" | sort -u | grep -v '^$')
    
    staticEntries=("TTY" "reboot" "shutdown")
    
    # set the options array as default (global variable for use in main script)
    if [[ -n "$all_sessions" ]]; then
        options=($all_sessions ${staticEntries[@]})
    else
        options=(${staticEntries[@]})
    fi
    
    # Check if there are any options
    if [[ ${#options[@]} -eq 0 ]]; then
        center "${boldText}$(tput setaf 1)No options available!${resetColor}"
        sleep 3
        exec $SHELL
    fi
    
    # create select menu from options
    selectOption "${options[@]}"
    # set the user choice (global variable for use in main script)
    choice=$?
    newUserChoice=${options[$choice]}
    # set user choice to use next time :
    containsElement "$newUserChoice" "${staticEntries[@]}"
    if [ $? -eq 1 ]; then
        if [[ $(grep "^lastUserChoice=" "$configFile") ]]; then
            sed -i "s/lastUserChoice=\"$lastUserChoice\"/lastUserChoice=\"$newUserChoice\"/" "$configFile"
        elif [[ $(grep "^#lastUserChoice=" "$configFile") ]]; then
            sed -i '/#lastUserChoice/d' "$configFile"
            echo -e "lastUserChoice=\"$newUserChoice\"" >>"$configFile"
        else
            echo -e "lastUserChoice=\"$newUserChoice\"" >>"$configFile"
        fi
    fi

}

